# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Security
SECRET_KEY=learnmate_ai_super_secret_jwt_key_hackathon_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./learnmate.db

# AI Provider Configuration
# Supported providers: "mock", "gemini", "openai", "ollama"
# Default is "mock" which provides a fully functional, deterministic AI study companion & quiz generator without external API keys
LLM_PROVIDER=mock

# Gemini API Key (if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# OpenAI API Key (if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Ollama Base URL (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
